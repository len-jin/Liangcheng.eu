        </div>
      </div>
    </div>
  </div>
</section>

<!-- SERVICES -->
<section id="services">
  <div class="section-label">业务版图</div>
  <h2 class="section-title" style="color:var(--paper)">四大核心板块<br>覆盖跨境全链条</h2>
  <p class="section-lead">从商旅接待到文化交流，从商品贸易到企业管理，良程国际以专业团队与本地资源，为您提供端到端的跨境综合解决方案。</p>

  <div class="services-grid">

    <!-- 商旅 -->
