<!DOCTYPE html>
<html lang="zh-HK">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>良程国际有限公司 | Liangcheng International Limited</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@300;400;600;700&family=Noto+Sans+SC:wght@300;400;500&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --gold: #D4B46A;           /* 提升亮度，更温润高级 */
  --gold-light: #E8D9B8;     /* 更亮的金色 */
  --gold-dark: #A17F3F;      /* 深金色备用 */
  --ink: #0F0F0D;            /* 主体文字稍亮 */
  --ink-soft: #1A1814;       /* 深色背景稍提亮 */
  --paper: #F8F6F0;          /* 主背景更干净温暖 */
  --paper-warm: #F2EDE4;     /* 温暖浅背景 */
  --muted: #5C564E;          /* 辅助文字稍提亮 */
  --border: #E2D9C9;         /* 边框更柔和 */
  --section-pad: 120px;
}
html{scroll-behavior:smooth}
body{
  font-family:'Noto Sans SC',sans-serif;
  background:var(--paper);
  color:var(--ink);
  font-weight:300;
  line-height:1.8;
  overflow-x:hidden;
}

/* NAV */
nav{
  position:fixed;top:0;left:0;right:0;z-index:100;
  padding:0 60px;
  height:72px;
  display:flex;align-items:center;justify-content:space-between;
  background:rgba(248,246,240,0.95);
  backdrop-filter:blur(12px);
  border-bottom:1px solid var(--border);
  transition:all 0.3s;
}
.nav-logo{
  font-family:'Cormorant Garamond',serif;
  font-size:1.05rem;
  font-weight:600;
  letter-spacing:0.12em;
  color:var(--ink);
  text-decoration:none;
  display:flex;flex-direction:column;line-height:1.2;
}
.nav-logo span{
  font-family:'Noto Sans SC',sans-serif;
  font-size:0.6rem;
  font-weight:300;
  letter-spacing:0.2em;
  color:var(--muted);
}
.nav-links{display:flex;gap:40px;list-style:none}
.nav-links a{
  font-size:0.72rem;letter-spacing:0.15em;
  color:var(--muted);text-decoration:none;
  transition:color 0.2s;font-weight:400;
}
.nav-links a:hover{color:var(--gold)}

/* HERO */
#hero{
  min-height:100vh;
  display:flex;align-items:center;
  position:relative;
  overflow:hidden;
  background:var(--ink-soft);
  padding:0 60px;
}
.hero-bg{
  position:absolute;inset:0;
  background:
    radial-gradient(ellipse 60% 80% at 70% 50%, rgba(212,180,106,0.10) 0%, transparent 70%),
    radial-gradient(ellipse 40% 60% at 20% 80%, rgba(212,180,106,0.07) 0%, transparent 60%),
    linear-gradient(135deg, #11110F 0%, #1F1C17 50%, #11110F 100%);
}
.hero-line{
  position:absolute;top:0;bottom:0;left:50%;width:1px;
  background:linear-gradient(to bottom, transparent, rgba(212,180,106,0.35), transparent);
}
.hero-content{
  position:relative;z-index:2;
  max-width:760px;
  opacity:0;animation:fadeUp 1.2s 0.3s forwards;
}
.hero-eyebrow{
  font-family:'Cormorant Garamond',serif;
  font-size:0.85rem;letter-spacing:0.35em;
  color:var(--gold);text-transform:uppercase;
  margin-bottom:32px;
  display:flex;align-items:center;gap:20px;
}
.hero-eyebrow::before{content:'';display:block;width:40px;height:1px;background:var(--gold)}
.hero-title{
  font-family:'Noto Serif SC',serif;
  font-size:clamp(2.8rem,5vw,4.5rem);
  font-weight:300;
  color:#FAFAF7;
  line-height:1.25;
  letter-spacing:0.05em;
  margin-bottom:16px;
}
.hero-title em{
  font-style:normal;
  color:var(--gold);
}
.hero-subtitle{
  font-family:'Cormorant Garamond',serif;
  font-size:1.25rem;
  color:rgba(250,250,247,0.65);
  letter-spacing:0.08em;
  margin-bottom:48px;
  font-weight:300;
}
.hero-desc{
  font-size:0.88rem;color:rgba(250,250,247,0.75);
  line-height:2;max-width:560px;margin-bottom:56px;
  font-weight:300;
}
.hero-cta{
  display:inline-flex;align-items:center;gap:16px;
  font-size:0.72rem;letter-spacing:0.2em;
  color:var(--gold);text-decoration:none;
  border:1px solid rgba(212,180,106,0.45);
  padding:16px 36px;
  transition:all 0.3s;
}
.hero-cta:hover{background:rgba(212,180,106,0.12);border-color:var(--gold)}
.hero-cta::after{content:'→';transition:transform 0.3s}
.hero-cta:hover::after{transform:translateX(6px)}
.hero-stats{
  position:absolute;right:60px;bottom:80px;
  display:flex;flex-direction:column;gap:32px;
  z-index:2;
  opacity:0;animation:fadeUp 1.2s 0.8s forwards;
}
.hero-stat{text-align:right}
.hero-stat-num{
  font-family:'Cormorant Garamond',serif;
  font-size:2.2rem;font-weight:300;color:var(--gold);
  line-height:1;
}
.hero-stat-label{
  font-size:0.62rem;letter-spacing:0.2em;color:rgba(250,250,247,0.55);
  margin-top:4px;
}
.scroll-hint{
  position:absolute;bottom:40px;left:60px;
  display:flex;align-items:center;gap:12px;
  font-size:0.62rem;letter-spacing:0.2em;color:rgba(250,250,247,0.4);
  z-index:2;
}
.scroll-line{width:40px;height:1px;background:rgba(212,180,106,0.35);position:relative;overflow:hidden}
.scroll-line::after{
  content:'';position:absolute;top:0;left:-100%;width:100%;height:100%;
  background:var(--gold);animation:scrollLine 2s 1.5s infinite;
}
@keyframes scrollLine{0%{left:-100%}100%{left:100%}}

/* SECTIONS COMMON */
section{padding:var(--section-pad) 60px}
.section-label{
  font-size:0.65rem;letter-spacing:0.3em;color:var(--gold);
  text-transform:uppercase;margin-bottom:24px;
  display:flex;align-items:center;gap:16px;
}
.section-label::before{content:'';display:block;width:24px;height:1px;background:var(--gold)}
.section-title{
  font-family:'Noto Serif SC',serif;
  font-size:clamp(1.8rem,3vw,2.8rem);
  font-weight:300;line-height:1.3;
  letter-spacing:0.05em;margin-bottom:20px;
}
.section-lead{
  font-size:0.9rem;color:var(--muted);
  max-width:680px;line-height:2;
}

/* ABOUT */
#about{background:var(--paper)}
.about-grid{
  display:grid;grid-template-columns:1fr 1fr;
  gap:80px;align-items:start;margin-top:64px;
}
.about-text p{
  font-size:0.88rem;color:var(--muted);line-height:2.2;margin-bottom:20px;
}
.about-pillars{display:flex;flex-direction:column;gap:1px;background:var(--border)}
.pillar{
  background:var(--paper);padding:28px 32px;
  display:flex;align-items:flex-start;gap:20px;
  transition:background 0.2s;
}
.pillar:hover{background:var(--paper-warm)}
.pillar-num{
  font-family:'Cormorant Garamond',serif;
  font-size:2rem;font-weight:300;color:var(--gold-light);
  line-height:1;min-width:40px;
}
.pillar-text strong{
  display:block;font-size:0.8rem;letter-spacing:0.1em;
  color:var(--ink);font-weight:500;margin-bottom:4px;
}
.pillar-text span{font-size:0.78rem;color:var(--muted)}

/* SERVICES */
#services{background:var(--ink-soft);color:var(--paper)}
#services .section-lead{color:rgba(250,250,247,0.65)}
.services-grid{
  display:grid;grid-template-columns:repeat(2,1fr);
  gap:1px;background:rgba(255,255,255,0.08);
  margin-top:64px;
}
.service-card{
  background:var(--ink-soft);
  padding:56px 48px;
  position:relative;overflow:hidden;
  transition:background 0.3s;
  cursor:default;
}
.service-card::before{
  content:'';position:absolute;top:0;left:0;right:0;height:2px;
  background:var(--gold);transform:scaleX(0);transform-origin:left;
  transition:transform 0.4s;
}
.service-card:hover{background:#1F1C17}
.service-card:hover::before{transform:scaleX(1)}
.service-icon{
  font-size:1.8rem;margin-bottom:28px;
  filter:grayscale(1) brightness(1.6);
  transition:filter 0.3s;
}
.service-card:hover .service-icon{filter:none}
.service-num{
  position:absolute;top:32px;right:40px;
  font-family:'Cormorant Garamond',serif;
  font-size:4rem;font-weight:300;
  color:rgba(255,255,255,0.06);
  line-height:1;
}
.service-tag{
  font-size:0.6rem;letter-spacing:0.25em;color:var(--gold);
  text-transform:uppercase;margin-bottom:16px;
}
.service-card h3{
  font-family:'Noto Serif SC',serif;
  font-size:1.3rem;font-weight:400;
  color:var(--paper);margin-bottom:20px;
  letter-spacing:0.05em;line-height:1.4;
}
.service-card p{
  font-size:0.8rem;color:rgba(250,250,247,0.65);
  line-height:2;margin-bottom:28px;
}
.service-items{list-style:none;display:flex;flex-direction:column;gap:8px}
.service-items li{
  font-size:0.75rem;color:rgba(250,250,247,0.55);
  display:flex;align-items:center;gap:10px;
}
.service-items li::before{
  content:'';display:block;width:16px;height:1px;
  background:rgba(212,180,106,0.45);flex-shrink:0;
}
.service-link{
  display:inline-flex;align-items:center;gap:8px;
  margin-top:32px;font-size:0.68rem;letter-spacing:0.15em;
  color:var(--gold);text-decoration:none;
  border-bottom:1px solid rgba(212,180,106,0.35);
  padding-bottom:4px;transition:all 0.2s;
}
.service-link:hover{border-color:var(--gold);gap:14px}

/* TOURISM FEATURE */
#tourism{
  background:var(--paper-warm);
  position:relative;overflow:hidden;
}
#tourism::before{
  content:'EUROPE';
  position:absolute;right:-40px;top:50%;transform:translateY(-50%);
  font-family:'Cormorant Garamond',serif;
  font-size:14rem;font-weight:300;
  color:rgba(212,180,106,0.07);
  letter-spacing:-0.05em;white-space:nowrap;
  pointer-events:none;
}
.tourism-inner{
  display:grid;grid-template-columns:5fr 4fr;
  gap:80px;align-items:start;
}
.tourism-badge{
  display:inline-flex;align-items:center;gap:8px;
  background:var(--gold);color:var(--ink);
  font-size:0.6rem;letter-spacing:0.2em;
  padding:8px 20px;margin-bottom:40px;
}
.tourism-features{
  display:grid;grid-template-columns:1fr 1fr;
  gap:1px;background:var(--border);margin-top:48px;
}
.tf{
  background:var(--paper-warm);padding:28px 24px;
  transition:background 0.2s;
}
.tf:hover{background:#FAF6EC}
.tf-icon{font-size:1.2rem;margin-bottom:12px}
.tf h4{
  font-size:0.78rem;font-weight:500;
  letter-spacing:0.08em;margin-bottom:6px;
}
.tf p{font-size:0.72rem;color:var(--muted);line-height:1.8}
.tourism-aside{padding-top:80px}
.tourism-aside-card{
  background:var(--ink-soft);color:var(--paper);
  padding:40px 36px;margin-bottom:1px;
}
.tourism-aside-card h4{
  font-family:'Cormorant Garamond',serif;
  font-size:1.4rem;font-weight:300;color:var(--gold);
  margin-bottom:16px;
}
.tourism-aside-card p{
  font-size:0.78rem;color:rgba(250,250,247,0.6);line-height:2;
}
.region-list{list-style:none;margin-top:16px;display:flex;flex-direction:column;gap:8px}
.region-list li{
  font-size:0.75rem;color:rgba(250,250,247,0.55);
  display:flex;align-items:center;gap:10px;
}
.region-list li::before{content:'◆';font-size:0.4rem;color:var(--gold)}

/* ADVANTAGE */
#advantage{background:var(--paper)}
.adv-grid{
  display:grid;grid-template-columns:repeat(3,1fr);
  gap:48px;margin-top:64px;
}
.adv-item{
  border-top:1px solid var(--border);padding-top:32px;
}
.adv-num{
  font-family:'Cormorant Garamond',serif;
  font-size:3rem;font-weight:300;color:var(--gold-light);
  line-height:1;margin-bottom:20px;
}
.adv-item h4{
  font-size:0.88rem;font-weight:500;
  letter-spacing:0.08em;margin-bottom:12px;
}
.adv-item p{font-size:0.78rem;color:var(--muted);line-height:2}

/* CONTACT */
#contact{
  background:var(--ink-soft);
  color:var(--paper);
  position:relative;overflow:hidden;
}
#contact::before{
  content:'';position:absolute;inset:0;
  background:radial-gradient(ellipse 50% 70% at 80% 50%, rgba(212,180,106,0.09) 0%, transparent 70%);
}
.contact-inner{
  display:grid;grid-template-columns:1fr 1fr;
  gap:80px;align-items:start;position:relative;z-index:1;
}
.contact-heading{
  font-family:'Noto Serif SC',serif;
  font-size:clamp(2rem,3.5vw,3rem);
  font-weight:300;line-height:1.3;
  letter-spacing:0.05em;margin-bottom:24px;
}
.contact-heading em{font-style:normal;color:var(--gold)}
.contact-desc{
  font-size:0.85rem;color:rgba(250,250,247,0.65);
  line-height:2;max-width:440px;
}
.contact-details{display:flex;flex-direction:column;gap:1px;background:rgba(255,255,255,0.06)}
.contact-item{
  background:rgba(255,255,255,0.03);
  padding:28px 32px;
  display:flex;align-items:flex-start;gap:20px;
  transition:background 0.2s;
}
.contact-item:hover{background:rgba(255,255,255,0.07)}
.contact-item-icon{
  width:36px;height:36px;border:1px solid rgba(212,180,106,0.35);
  display:flex;align-items:center;justify-content:center;
  font-size:0.9rem;flex-shrink:0;margin-top:2px;
}
.contact-item-text label{
  display:block;font-size:0.6rem;letter-spacing:0.2em;
  color:var(--gold);text-transform:uppercase;margin-bottom:6px;
}
.contact-item-text a,
.contact-item-text p{
  font-size:0.82rem;color:rgba(250,250,247,0.75);
  text-decoration:none;line-height:1.6;
}
.contact-item-text a:hover{color:var(--gold)}

/* FOOTER */
footer{
  background:var(--ink);
  padding:32px 60px;
  display:flex;align-items:center;justify-content:space-between;
  border-top:1px solid rgba(255,255,255,0.06);
}
.footer-logo{
  font-family:'Cormorant Garamond',serif;
  font-size:0.9rem;letter-spacing:0.15em;color:rgba(250,250,247,0.35);
}
.footer-copy{
  font-size:0.65rem;letter-spacing:0.1em;color:rgba(250,250,247,0.25);
}

/* DIVIDER */
.gold-divider{
  width:48px;height:1px;background:var(--gold);
  margin:32px 0;
}

/* ANIMATIONS */
@keyframes fadeUp{
  from{opacity:0;transform:translateY(30px)}
  to{opacity:1;transform:translateY(0)}
}
.reveal{opacity:0;transform:translateY(24px);transition:opacity 0.8s,transform 0.8s}
.reveal.visible{opacity:1;transform:translateY(0)}

/* MOBILE */
@media(max-width:900px){
  nav{padding:0 24px}
  .nav-links{display:none}
  #hero,section{padding-left:24px;padding-right:24px}
  .hero-stats{display:none}
  .about-grid,.services-grid,.tourism-inner,.adv-grid,
  .contact-inner{grid-template-columns:1fr}
  .tourism-features{grid-template-columns:1fr}
  footer{flex-direction:column;gap:12px;text-align:center}
  #tourism::before{display:none}
}
</style>
</head>
<body>

